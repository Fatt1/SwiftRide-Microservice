{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "SwiftRideSuperSecretKeyForJwtTokenSigning2026!#@$VeryLongKey",
    "Issuer": "SwiftRide.Identity",
    "Audience": "SwiftRide.Client",
    "ExpiryMinutes": 60
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/{version}/auth/{**catch-all}"
        }
      },
      "identity-root-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/{version}/auth"
        }
      },
      "identity-users-root-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/{version}/users"
        }
      },
      "matching-route": {
        "ClusterId": "matching-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/{version}/matching/{**catch-all}"
        }
      },
      "matching-root-route": {
        "ClusterId": "matching-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/{version}/matching"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/{version}/payments/{**catch-all}"
        }
      },
      "payment-root-route": {
        "ClusterId": "payment-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/{version}/payments"
        }
      },
      "trip-route": {
        "ClusterId": "trip-cluster",
        "Match": {
          "Path": "/api/{version}/trips/{**catch-all}"
        }
      },
      "trip-root-route": {
        "ClusterId": "trip-cluster",
        "Match": {
          "Path": "/api/{version}/trips"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "matching-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5005"
          }
        }
      },
      "trip-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}