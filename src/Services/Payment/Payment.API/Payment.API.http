@Payment.API_HostAddress = http://localhost:6003
@paymentId = REPLACE_WITH_PAYMENT_ID

### Charge a mock card. Reuse these IDs to replay the same request.
POST {{Payment.API_HostAddress}}/api/v1/payments
Content-Type: application/json

{
  "tripId": "11111111-1111-1111-1111-111111111111",
  "riderId": "22222222-2222-2222-2222-222222222222",
  "driverId": "33333333-3333-3333-3333-333333333333",
  "amount": 50000,
  "paymentMethod": "Card",
  "idempotencyKey": "44444444-4444-4444-4444-444444444444",
  "currency": "VND",
  "gatewayToken": "mock-success"
}

### Get the payment ID returned by the charge request.
GET {{Payment.API_HostAddress}}/api/v1/payments/{{paymentId}}

### Full refund via HTTP only. Repeating this returns the existing refund.
POST {{Payment.API_HostAddress}}/api/v1/payments/{{paymentId}}/refund
Content-Type: application/json

{
  "reason": "Customer requested a refund"
}

### Declined mock card
POST {{Payment.API_HostAddress}}/api/v1/payments
Content-Type: application/json

{
  "tripId": "55555555-5555-5555-5555-555555555555",
  "riderId": "22222222-2222-2222-2222-222222222222",
  "driverId": "33333333-3333-3333-3333-333333333333",
  "amount": 50000,
  "paymentMethod": "Card",
  "idempotencyKey": "66666666-6666-6666-6666-666666666666",
  "gatewayToken": "mock-decline"
}
