# Local: http://localhost:5005 | Docker: http://localhost:6005
@Payment.API_HostAddress = http://localhost:5005
@paymentId = REPLACE_WITH_PAYMENT_ID
@tripId = REPLACE_WITH_TRIP_ID_FROM_FAILED_PAYMENT

### Retry a failed trip payment with a new idempotency key
POST {{Payment.API_HostAddress}}/api/v1/payments
Content-Type: application/json

{
  "tripId": "{{tripId}}",
  "paymentMethod": "Card",
  "idempotencyKey": "44444444-4444-4444-4444-444444444444",
  "currency": "VND",
  "gatewayToken": "mock-success"
}

### Get the payment ID returned by the charge request.
GET {{Payment.API_HostAddress}}/api/v1/payments/{{paymentId}}

### Full refund via HTTP only. Repeating this returns the existing refund.
POST {{Payment.API_HostAddress}}/api/v1/payments/{{paymentId}}/refund
Content-Type: application/json

{
  "reason": "Customer requested a refund"
}

### Retry another trip that has a failed payment and simulate a decline
POST {{Payment.API_HostAddress}}/api/v1/payments
Content-Type: application/json

{
  "tripId": "{{tripId}}",
  "paymentMethod": "Card",
  "idempotencyKey": "66666666-6666-6666-6666-666666666666",
  "gatewayToken": "mock-decline"
}

### Get all wallets (GET /api/v1/payments/wallets)
GET {{Payment.API_HostAddress}}/api/v1/payments/wallets
Accept: application/json

### Top up wallet (POST /api/v1/payments/wallets/{userId}/top-up)
POST {{Payment.API_HostAddress}}/api/v1/payments/wallets/22222222-2222-2222-2222-222222222222/top-up
Content-Type: application/json

{
  "idempotencyKey": "77777777-7777-7777-7777-777777777777",
  "amount": 100000
}

### Get ledger history (GET /api/v1/payments/ledger)
GET {{Payment.API_HostAddress}}/api/v1/payments/ledger
Accept: application/json

